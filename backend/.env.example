APP_NAME=ActionPilot
OLLAMA_MODEL=gemma3:latest
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_CTX=128000
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
FALLBACK_EMBEDDING_MODEL=nomic-embed-text
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_MIN_CANDIDATES=8
RETRIEVAL_CANDIDATES=8
RETRIEVAL_TOP_K=4
ANSWER_LLM_ENABLED=true
ANSWER_LLM_MIN_SOURCE_CHARS=0
CHROMA_DIR=./data/chroma
DOCS_DIR=./data/docs
RUNTIME_DIR=./data/runtime
MAX_AGENT_STEPS=5
MEMORY_CONTEXT_TOKENS=128000
MEMORY_RECENT_TOKENS=8000
NEO4J_ENABLED=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=actionpilot
NEO4J_TIMEOUT_SECONDS=1.5
TICKETING_BACKEND=local
GITHUB_REPO=your-github-user-or-org/your-repo
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
CLEAR_RUNTIME_ON_STARTUP=true
